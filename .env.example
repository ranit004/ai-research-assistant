# Copy this file to .env and adjust values. .env is gitignored; never commit real secrets.

# Application
APP_NAME="AI Research Assistant"
ENVIRONMENT=development
DEBUG=false

# Logging
LOG_LEVEL=INFO

# HTTP server
API_HOST=0.0.0.0
API_PORT=8000

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_docs
# QDRANT_API_KEY=          # Set only for cloud/auth-enabled Qdrant instances

# Groq (required for LLM reasoning — get a free key at console.groq.com)
# GROQ_API_KEY=gsk_...

GROQ_MODEL=openai/gpt-oss-120b

# Embeddings (local FastEmbed / ONNX — no API key required)
# Model is downloaded on first use via FastEmbed cache.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Ingestion limits
MAX_UPLOAD_BYTES=10485760  # 10 MB
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Research engine
RESEARCH_LLM_TEMPERATURE=0.0
MAX_SUB_QUESTIONS=4        # hard cap on query decomposition
MAX_RESEARCH_ITERATIONS=3  # max evidence-refinement loops
EVIDENCE_MIN_SCORE=0.35    # minimum cosine similarity for a hit to count
EVIDENCE_TOP_K=5           # retrieved chunks per sub-question

# Conversation limits
MAX_QUESTION_LENGTH=2000   # maximum question characters accepted
MAX_HISTORY_TURNS=10       # conversation turns passed to the research graph
