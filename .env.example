# Copy this file to .env and adjust values. .env is gitignored; never commit real secrets.

# Application
APP_NAME="AI Research Assistant"
ENVIRONMENT=development
DEBUG=false

# Logging
LOG_LEVEL=INFO

# HTTP server
API_HOST=0.0.0.0
API_PORT=8000

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_docs
# QDRANT_API_KEY=          # Set only for cloud/auth-enabled Qdrant instances

# OpenAI embeddings
# OPENAI_API_KEY=          # Required for embedding generation
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Ingestion limits
MAX_UPLOAD_BYTES=10485760  # 10 MB
CHUNK_SIZE=512
CHUNK_OVERLAP=64
